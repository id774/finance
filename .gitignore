.DS_Store
.svn

# Generated data. The stock lists under data/ are tracked; everything
# the pipeline writes into it is not. Market data obtained from the
# J-Quants API must never be committed: the licence covers personal
# analysis, not redistribution, and a public repository is
# redistribution.
data/*.csv
data/*.png
data/data_source.txt
data/history/
data/legacy.*/
clf/*.pickle
log/*.log
*.pickle

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local configuration and credentials. The API key belongs in the
# environment, but an env file left in the working tree must not be
# committed either.
config.yml
env
.env
*.env
jquants-api.toml
